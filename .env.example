# Copy to .env and edit.
PORT=3000
TIMEZONE=America/New_York
DATA_DIR=./data
# Set true when served over HTTPS (staff cookie gets the Secure flag)
COOKIE_SECURE=false

# First-run admin account (only used when there are no staff yet)
ADMIN_NAME=Owner
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# --- Staff notifications ---
# Push (free, easiest): ntfy. Staff install the "ntfy" app and subscribe to a topic.
NTFY_SERVER=https://ntfy.sh
# SMS (optional): Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
