# Copy to .env and edit.
PORT=3000
TIMEZONE=America/New_York
DATA_DIR=./data
# Set true when served over HTTPS (staff cookie gets the Secure flag)
COOKIE_SECURE=false

# First-run admin account (only used when there are no staff yet)
ADMIN_NAME=Owner
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# --- Escape Room Command Center high score API ---
# Leave ERCC_BASE_URL empty to use built-in demo scores.
# Enable the API in ERCC Settings, click "Open API Documentation" and copy the base URL
# and the high score endpoint path from that page.
ERCC_BASE_URL=
ERCC_SCORES_PATH=/highscores
# Optional auth header sent with every ERCC call, e.g. Authorization / Bearer abc123
ERCC_AUTH_HEADER=
ERCC_AUTH_VALUE=

# --- Staff notifications ---
# Push (free, easiest): ntfy. Staff install the "ntfy" app and subscribe to a topic.
NTFY_SERVER=https://ntfy.sh
# SMS (optional): Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
